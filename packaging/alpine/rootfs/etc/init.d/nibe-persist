#!/sbin/openrc-run
# Persistent system state (ADR 0107): bind-mount the declared directories from p3 over the read-only root, before
# anything that uses them. Same script and list as Raspberry Pi OS (/usr/lib/nibe-gateway/nibe-persist).
# Also keeps a forward-only clock floor on p3 (no RTC): swclock runs before p3 is mounted and only knows the
# image build time; this file's mtime is the last boot or clean shutdown.

description="NIBE persistent system state (bind mounts from the data partition)"
clock_file=/var/lib/nibe-gateway/system/clock

depend() {
	need localmount
	after swclock
	before dbus networkmanager sshd tailscale nibe-provision nibe-gateway nibe-system nibe-updater chronyd
}

start() {
	ebegin "Mounting persistent system state from the data partition"
	/usr/lib/nibe-gateway/nibe-persist
	eend $? || return 1
	if [ -f "$clock_file" ]; then
		saved=$(date -r "$clock_file" +%s 2>/dev/null || echo 0)
		if [ "$saved" -gt "$(date +%s)" ]; then
			date -s "@$saved" >/dev/null && einfo "Clock moved forward to the last saved time"
		fi
	fi
	touch "$clock_file"
	return 0
}

stop() {
	# The bind mounts are released by mount-ro at shutdown; only save the clock floor.
	touch "$clock_file" 2>/dev/null
	return 0
}
