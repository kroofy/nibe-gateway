{
  "name": "@nibe-gateway/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "generate:api": "node scripts/generate-api.mjs",
    "test:e2e": "node ../../tests/e2e/run.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "capture:fixtures": "node scripts/capture-fixtures.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
